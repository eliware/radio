# Copy this template to .env.pd and .env.fd. Keep each file private (mode 600).
# Each file holds one channel's Zello account, signing key, and SDR settings.
# Create a production JWT at runtime from ISSUER and PRIVATE_KEY.
# Do not put a Sample Development Token here.
CHANNEL=Windham Police Department
USERNAME=
PASSWORD=
ISSUER=
SDR_SERIAL=
FREQUENCY_MHZ=
CTCSS_HZ=
TONE=
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
replace with private key body
-----END PRIVATE KEY-----"
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
replace with public key body
-----END PUBLIC KEY-----"
