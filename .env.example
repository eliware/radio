# Copy this template to .env.pd and .env.fd. Keep each private with mode 600.
# Set a distinct UDP_PORT in each file. The example values are Police 15581 and Fire 15422.
# CHANNEL: Zello channel name. USERNAME and PASSWORD: account login.
CHANNEL=Windham Police Department
USERNAME=
PASSWORD=
# ISSUER and PRIVATE_KEY: production signing details from the Zello developer key.
ISSUER=
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
replace with private key body
-----END PRIVATE KEY-----"
# SDR_SERIAL: unique RTL-SDR serial. FREQUENCY_MHZ: 24 to 1766 MHz.
SDR_SERIAL=
FREQUENCY_MHZ=
# CTCSS_HZ: 67 to 254.1 Hz. TONE: startup test tone from 200 to 3000 Hz.
CTCSS_HZ=
TONE=
# UDP_PORT: unique local port from 1024 to 65535 for this channel.
UDP_PORT=15581
# RNNOISE: 0 to 100 percent processed audio. 80 retains 20 percent unprocessed audio.
RNNOISE=80
# PUBLIC_KEY is optional account reference data. The runtime does not read it.
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
replace with public key body
-----END PUBLIC KEY-----"
