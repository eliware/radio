# Copy this template to .env.pd or .env.fd. Keep each file private with mode 600.

# General
TONE=1000
RNNOISE=80

# SDR
SDR_SERIAL=replace-with-dongle-serial
SDR_GAIN=10
FREQUENCY_MHZ=replace-with-channel-frequency
CTCSS_HZ=replace-with-channel-tone
UDP_PORT=replace-with-unique-port

# Broadcastify Classic
BROADCASTIFY_ENABLED=false
BROADCASTIFY_HOST=replace-with-approved-host
BROADCASTIFY_PORT=replace-with-approved-port
BROADCASTIFY_MOUNT=replace-with-approved-mount
BROADCASTIFY_PASSWORD=replace-with-approved-password
BROADCASTIFY_NAME=replace-with-feed-name

# Zello
CHANNEL=replace-with-channel-name
USERNAME=replace-with-account-name
PASSWORD=replace-with-account-password
ISSUER=replace-with-production-key-issuer
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
replace-with-production-private-key
-----END PRIVATE KEY-----"
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
replace-with-public-key-reference
-----END PUBLIC KEY-----"
