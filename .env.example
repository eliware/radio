# Receiver serial numbers for the two radio dongles. Do not use the Radar 1090 dongle.
RADIO_POLICE_SDR_SERIAL=
RADIO_FIRE_SDR_SERIAL=

# Local channel settings.
RADIO_POLICE_FREQUENCY_MHZ=158.8125
RADIO_POLICE_PL_HZ=77.0
RADIO_FIRE_FREQUENCY_MHZ=154.2200
RADIO_FIRE_PL_HZ=156.7

# Generate a private random password for the SDR-to-Icecast connection.
ICECAST_SOURCE_PASSWORD=

# Optional web server port. Defaults to 3000.
# PORT=3000
